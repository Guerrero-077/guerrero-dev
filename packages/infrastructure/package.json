{
  "name": "@guerrero-dev/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node -e \"require('fs').cpSync('src/database/migrations','dist/database/migrations',{recursive:true})\"",
    "typecheck": "tsc -b --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@guerrero-dev/application": "workspace:*",
    "@guerrero-dev/domain": "workspace:*",
    "@guerrero-dev/shared": "workspace:*",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0"
  }
}
