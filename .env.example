NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL + pgvector — docker-compose.yml lee POSTGRES_USER/PASSWORD/DB de
# acá (Docker Compose carga automáticamente el .env de la raíz del repo);
# mantené estos tres en sync con las credenciales embebidas en DATABASE_URL.
POSTGRES_USER=guerrero
POSTGRES_PASSWORD=guerrero
POSTGRES_DB=guerrero_dev
DATABASE_URL=postgresql://guerrero:guerrero@localhost:5432/guerrero_dev

# Ollama (local LLM runtime — correr nativo en el host para aprovechar la GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b-instruct-q4_K_M
# ^ Desde Fase 5.14, este es el ÚNICO consumidor real de OLLAMA_DEFAULT_MODEL:
# AgentOrchestrator ya no hace una inferencia de texto plano propia (esa
# llamada standalone a OllamaProvider.generate() desapareció junto con
# ILLMProvider como dependencia del orquestador — su resultado no lo
# consumía nadie). El modelo elegido acá corre directo dentro de
# OpenCodeExecutionEngine (`agent run`), que SÍ necesita tool-calling
# estructurado real. qwen2.5:7b-instruct-q4_K_M es el único modelo local
# confirmado con tool-calling confiable en este repo (Fase 5.9 — probado
# contra POST /api/chat de Ollama, no solo contra OpenCode); gemma3:4b no
# soporta tools en Ollama en absoluto, y qwen2.5-coder:7b los soporta según
# su propio template pero no los envuelve de forma consistente en la
# práctica. Sobreescribí puntualmente con --model si querés probar otro.

# Embeddings (Fase 4.4 — ver docs/fase-4-memory-engine.md): single provider,
# qwen3-embedding:4b via Ollama, truncado a 1024 dims vía MRL.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=1024

# Cloud LLM (opcional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# API
API_PORT=3000
API_HOST=0.0.0.0
