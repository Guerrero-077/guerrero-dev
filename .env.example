NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL + pgvector (ver docker-compose.yml)
DATABASE_URL=postgresql://guerrero:guerrero@localhost:5432/guerrero_dev

# Ollama (local LLM runtime — correr nativo en el host para aprovechar la GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b

# Embeddings (Fase 4.4 — ver docs/fase-4-memory-engine.md): single provider,
# qwen3-embedding:4b via Ollama, truncado a 1024 dims vía MRL.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=1024

# Cloud LLM (opcional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# API
API_PORT=3000
API_HOST=0.0.0.0
