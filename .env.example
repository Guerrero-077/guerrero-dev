NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL + pgvector (ver docker-compose.yml)
DATABASE_URL=postgresql://guerrero:guerrero@localhost:5432/guerrero_dev

# Ollama (local LLM runtime — correr nativo en el host para aprovechar la GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b
# ^ Usado también por OllamaProvider.generate() (ContextBuilder/AgentOrchestrator,
# texto plano, sin tools) — gemma3:4b funciona bien ahí y es liviano, por eso es
# el default. PERO `agent run` ejecuta vía OpenCodeExecutionEngine, que SÍ
# necesita tool-calling, y gemma3:4b no lo soporta en Ollama. Para `agent run`,
# sobreescribí OLLAMA_DEFAULT_MODEL puntualmente con un modelo que sí lo
# soporte, p. ej.: OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b agent run "..."

# Embeddings (Fase 4.4 — ver docs/fase-4-memory-engine.md): single provider,
# qwen3-embedding:4b via Ollama, truncado a 1024 dims vía MRL.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=1024

# Cloud LLM (opcional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# API
API_PORT=3000
API_HOST=0.0.0.0
